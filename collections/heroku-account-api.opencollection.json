{
  "opencollection": "1.0.0",
  "info": {
    "name": "Heroku Platform Account API",
    "version": "3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.heroku.com/account"
          },
          "docs": "Get account info"
        },
        {
          "info": {
            "name": "Update account",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.heroku.com/account",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update account"
        }
      ]
    }
  ],
  "bundled": true
}